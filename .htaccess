# Mengaktifkan Mesin Rewrite
Options +FollowSymLinks
RewriteEngine On

# Mencegah listing isi direktori
Options -Indexes

# Mengalihkan semua permintaan ke HTTPS (jika diperlukan, hapus komentar di bawah)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Melindungi file-file sensitif
<FilesMatch "\.(sql|ini|log|phar|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Melindungi file konfigurasi secara spesifik
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Aturan dasar untuk URL rewriting (contoh)
# Jika Anda ingin menghapus .php dari URL
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME}\.php -f
# RewriteRule ^(.*)$ $1.php [L]